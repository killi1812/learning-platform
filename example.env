# App & Security
PORT = 8080
ACCESS_KEY = "your-access-key-here"
REFRESH_KEY = "your-refresh-key-here"
SUPERADMIN_EMAIL = "superadmin@example.com"
SUPERADMIN_PASSWORD = "Pa\$\$w0rd"
APP_IMAGE = "dat250-project-app:latest"

LOG_QUERY = "True"

# Backend Connections
DATABASE_CONN = "postgres://postgres:postgres@localhost:5432/learning_platform?sslmode=disable"
MONGO_CONN = "mongodb://localhost:27018"
SEAWEEDFS_ENDPOINT = "http://localhost:8888"
RABBITMQ_CONN = "amqp://admin:admin@localhost:5672/"

# PostgreSQL (Docker)
POSTGRES_PORT = 5432
